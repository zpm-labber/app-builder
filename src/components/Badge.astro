---
const { text, tone = 'default' } = Astro.props;
const tones = {
  default: 'border-slate-500/20 bg-slate-400/[0.06] text-slate-300',
  cyan: 'border-cyan-300/30 bg-cyan-300/10 text-cyan-100 shadow-cyan-950/30',
  purple: 'border-violet-300/30 bg-violet-400/10 text-violet-100',
  green: 'border-emerald-300/30 bg-emerald-400/10 text-emerald-100 shadow-emerald-950/30',
};
---

<span class:list={['inline-flex items-center gap-1 rounded-md border px-2.5 py-1 font-mono text-[0.72rem] font-medium uppercase tracking-[0.08em]', tones[tone] ?? tones.default]}>
  <span class="h-1.5 w-1.5 rounded-full bg-current opacity-80"></span>
  {text}
</span>
