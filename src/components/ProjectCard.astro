---
import Badge from './Badge.astro';
import Card from './Card.astro';
import { slugFromEntry } from '../lib/content';
const { project } = Astro.props;
---

<Card href={`/projects/${slugFromEntry(project)}`}>
  <p class="mb-3 font-mono text-xs text-cyan-200">module://projects/{slugFromEntry(project)}</p>
  <div class="flex items-start justify-between gap-4">
    <h3 class="text-xl font-semibold text-white group-hover:text-cyan-100">{project.data.title}</h3>
    <Badge text={project.data.status} tone={project.data.status === 'active' ? 'green' : 'purple'} />
  </div>
  <p class="mt-3 leading-7 text-slate-300">{project.data.description}</p>
  <div class="mt-5 flex flex-wrap gap-2">
    {project.data.tags.map((tag) => <Badge text={tag} />)}
  </div>
  <div class="mt-5 flex gap-4 font-mono text-sm text-cyan-200">
    {project.data.github && <span>git remote</span>}
    {project.data.website && <span>open site</span>}
  </div>
</Card>
