---
const { href } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag href={href} class="terminal-pane group block rounded-lg transition duration-200 hover:-translate-y-1 hover:border-cyan-300/45 hover:shadow-[0_24px_70px_rgba(0,229,255,0.11)]">
  <div class="terminal-topbar">
    <span class="terminal-dots" aria-hidden="true"><span></span><span></span><span></span></span>
    <span class="truncate">panel://module</span>
    <span class="text-emerald-200/70">online</span>
  </div>
  <div class="relative p-5">
    <slot />
  </div>
</Tag>
