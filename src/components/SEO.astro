---
const {
  title = 'ZPMLabber',
  description = 'Open-source developer tools, SDKs, packages, experiments, and engineering notes.',
  type = 'website',
  canonical,
  image = '/og-default.svg',
} = Astro.props;
const site = Astro.site ?? new URL('https://zpmlabber.github.io');
const url = canonical ? new URL(canonical, site).toString() : new URL(Astro.url.pathname, site).toString();
const imageUrl = new URL(image, site).toString();
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={url} />
<meta property="og:image" content={imageUrl} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
