---
import Badge from './Badge.astro';
import Card from './Card.astro';
import { formatDate, readingTime, slugFromEntry } from '../lib/content';
const { post } = Astro.props;
---

<Card href={`/blog/${slugFromEntry(post)}`}>
  <p class="mb-3 font-mono text-xs text-emerald-200/80">~/blog/{slugFromEntry(post)}.md</p>
  <div class="flex flex-wrap gap-2">
    {post.data.tags.slice(0, 3).map((tag) => <Badge text={tag} />)}
  </div>
  <h3 class="mt-4 text-xl font-semibold text-white group-hover:text-cyan-100">{post.data.title}</h3>
  <p class="mt-3 leading-7 text-slate-300">{post.data.description}</p>
  <p class="mt-5 font-mono text-sm text-slate-500">stat --date {formatDate(post.data.date)} / {readingTime(post)}</p>
</Card>
