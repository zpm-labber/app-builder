---
const { eyebrow, title, description } = Astro.props;
---

<div class="mb-8 max-w-3xl">
  {eyebrow && <p class="prompt mb-3 text-sm">{eyebrow}</p>}
  <h2 class="text-3xl font-semibold text-white md:text-4xl">{title}</h2>
  {description && <p class="mt-3 text-base leading-7 text-slate-300">{description}</p>}
</div>
