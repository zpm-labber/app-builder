---
import TerminalCard from './TerminalCard.astro';
---

<section class="mx-auto flex max-w-6xl flex-col gap-8 px-4 py-16 sm:px-6 md:py-24 lg:px-8">
  <div class="terminal-pane -mt-3 rounded-xl md:-mt-4">
    <div class="terminal-topbar">
      <span class="terminal-dots" aria-hidden="true"><span></span><span></span><span></span></span>
      <span>~/identity/zpmlabber-wide-top.jpg</span>
      <span class="text-emerald-200/70">rendered</span>
    </div>
    <div class="relative p-4 md:p-5">
      <img
        class="hero-render-image w-full rounded-lg border border-cyan-300/15 shadow-[0_22px_80px_rgba(37,99,235,0.18)]"
        src="/zpmlabber-wide-top.jpg"
        alt="ZPMLabber wide artwork showing a developer workstation scene"
        loading="eager"
        onerror="this.onerror=null;this.src='/zpmlabber.png';"
      />
      <div class="hero-render-overlay absolute bottom-7 left-7 right-7 rounded-md border border-blue-400/30 bg-slate-950/42 px-4 py-3 font-mono text-sm text-cyan-100 backdrop-blur">
        <span class="text-emerald-200">$</span> sudo enter --mode software-god
      </div>
    </div>
  </div>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1.05fr)_minmax(24rem,0.95fr)] lg:items-start">
    <div class="flex flex-col justify-center">
      <div class="grid gap-3 md:grid-cols-[max-content_max-content_minmax(0,1fr)] md:items-center">
        <p class="prompt mb-0 text-sm">ssh zpmlabber.dev</p>
        <p class="hero-path-chip">~/zpmlabber/session.sh</p>
      </div>

      <h1 class="mt-5 text-5xl font-semibold leading-tight text-white md:text-7xl">ZPMLabber</h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">
        A maintainer workstation for open-source SDKs, packages, docs tooling, refactoring experiments, and engineering notes.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="command-link" href="/projects">cd ./projects</a>
        <a class="command-link" href="/blog">open blog</a>
        <a class="command-link" href="https://github.com/zpmlabber">github --open</a>
      </div>
      <div class="mt-8 grid max-w-xl grid-cols-3 gap-3 font-mono text-xs text-slate-400">
        <div class="rounded-md border border-white/10 bg-white/[0.035] p-3"><span class="text-emerald-200">08</span><br />projects</div>
        <div class="rounded-md border border-white/10 bg-white/[0.035] p-3"><span class="text-cyan-200">07</span><br />packages</div>
        <div class="rounded-md border border-white/10 bg-white/[0.035] p-3"><span class="text-violet-200">03</span><br />notes</div>
      </div>
    </div>

    <TerminalCard />
  </div>
</section>
