---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = await getCollection('projects');
---

<BaseLayout title="Projects | ZPMLabber" description="Larger open-source initiatives and experiments from ZPMLabber.">
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <SectionHeading eyebrow="systemctl list-units --type=project" title="Workspace subsystems" description="SDK ecosystems, package families, documentation kits, refactoring labs, and experiments with a clear maintainer surface." />
    <div class="grid gap-5 md:grid-cols-2">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</BaseLayout>
