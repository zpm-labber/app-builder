---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBox from '../components/SearchBox.astro';
---

<BaseLayout title="Search | ZPMLabber" description="Search ZPMLabber blog posts, projects, and package pages.">
  <section class="mx-auto max-w-4xl px-4 py-14 sm:px-6 lg:px-8">
    <p class="prompt mb-4 text-sm">find . -type page</p>
    <h1 class="text-4xl font-semibold text-white md:text-6xl">Search the workstation index.</h1>
    <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-300">The header icon opens a modal command palette, and this page keeps the same static Pagefind search UI available as a direct-link fallback.</p>
    <div class="mt-8">
      <SearchBox />
    </div>
  </section>
</BaseLayout>
