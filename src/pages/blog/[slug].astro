---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { byDateDesc, slugFromEntry } from '../../lib/content';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(byDateDesc);
  return posts.map((post, index) => ({
    params: { slug: slugFromEntry(post) },
    props: {
      post,
      previous: posts[index + 1] ? { ...posts[index + 1], slug: slugFromEntry(posts[index + 1]) } : undefined,
      next: posts[index - 1] ? { ...posts[index - 1], slug: slugFromEntry(posts[index - 1]) } : undefined,
    },
  }));
}

const { post, previous, next } = Astro.props;
const { Content, headings } = await render(post);
---

<PostLayout post={post} headings={headings} previous={previous} next={next}>
  <Content />
</PostLayout>
